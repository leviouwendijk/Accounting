#!/bin/zsh
set -e

mode=${1:-}

case "$mode" in
    full)
        (
            sbm || return 1;
            swift run t_accounting;
            cd Testing/accounting-example && ec;
        )
        ;;
    fast)
        (
            sbm || return 1;
            cd Testing/accounting-example && ec;
        )
        ;;
    ec)
        (
            cd Testing/accounting-example && ec;
        )
        ;;
    *)
        echo "usage: ./test <full|fast|ec>" >&2
        exit 1
        ;;
esac

